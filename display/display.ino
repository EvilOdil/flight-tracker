void setup() {
  Serial.begin(115200);

  // You no longer call SPI.begin() manually. 
  // TFT_eSPI handles the initialization in parallel mode natively.
  tft.begin();

  // 0 for Portrait mode
  tft.setRotation(0);                 
}

void loop() {
  updateFlightInfo("UAL203", "UNITED AIRLINES", "SFO -> LAX", "Boeing 737-900", b737_bmp);
  delay(5000); 

  updateFlightInfo("DAL405", "DELTA AIR LINES", "JFK -> LHR", "Airbus A330-300", a330_bmp);
  delay(5000); 
}

// ---------------------------------------------------------
// DYNAMIC FLIGHT INFORMATION RENDERER
// ---------------------------------------------------------
void updateFlightInfo(String flight, String airline, String route, String aircraft, const unsigned char* planeBitmap) {
  
  // Update to the TFT_eSPI constant for black
  tft.fillScreen(TFT_BLACK);

  // 1. Get current screen dimensions dynamically
  int screenW = tft.width();
  int screenH = tft.height();

  // 2. Calculate margins and line lengths based on width
  int marginLeft = screenW * 0.06; // 6% margin from the left
  int lineEndX   = screenW - marginLeft; // Stop line 6% from the right

  // 3. Calculate proportional Y spacing based on height percentages
  int yFlightLbl = screenH * 0.05;
  int yFlightVal = screenH * 0.11;
  int yLine1     = screenH * 0.23;

  int yAirLbl    = screenH * 0.28;
  int yAirVal    = screenH * 0.34;
  int yLine2     = screenH * 0.43;

  int yRouteLbl  = screenH * 0.48;
  int yRouteVal  = screenH * 0.54;
  int yLine3     = screenH * 0.65;

  int yCraftLbl  = screenH * 0.70;
  int yCraftVal  = screenH * 0.76;

  // --- BLOCK 1: FLIGHT ---
  tft.setCursor(marginLeft, yFlightLbl);
  tft.setTextColor(COLOR_LABEL);
  tft.setTextSize(2);
  tft.println("FLIGHT");

  tft.setCursor(marginLeft, yFlightVal);
  tft.setTextColor(COLOR_VALUE);
  tft.setTextSize(4);
  tft.println(flight);

  tft.drawLine(marginLeft, yLine1, lineEndX, yLine1, COLOR_LINE);

  // --- BLOCK 2: AIRLINE ---
  tft.setCursor(marginLeft, yAirLbl);
  tft.setTextColor(COLOR_LABEL);
  tft.setTextSize(2);
  tft.println("AIRLINE");

  tft.setCursor(marginLeft, yAirVal);
  tft.setTextColor(COLOR_VALUE);
  tft.setTextSize(2);
  tft.println(airline);

  tft.drawLine(marginLeft, yLine2, lineEndX, yLine2, COLOR_LINE);

  // --- BLOCK 3: ROUTE ---
  tft.setCursor(marginLeft, yRouteLbl);
  tft.setTextColor(COLOR_LABEL);
  tft.setTextSize(2);
  tft.println("ROUTE");

  tft.setCursor(marginLeft, yRouteVal);
  tft.setTextColor(COLOR_VALUE);
  tft.setTextSize(3); 
  tft.println(route);

  tft.drawLine(marginLeft, yLine3, lineEndX, yLine3, COLOR_LINE);

  // --- BLOCK 4: AIRCRAFT ---
  tft.setCursor(marginLeft, yCraftLbl);
  tft.setTextColor(COLOR_LABEL);
  tft.setTextSize(2);
  tft.println("AIRCRAFT");

  tft.setCursor(marginLeft, yCraftVal);
  tft.setTextColor(COLOR_VALUE);
  tft.setTextSize(2);
  tft.println(aircraft);

  // --- ICON: AIRPLANE ---
  // Center the image mathematically for a 200px wide image
  int planeX = (screenW - 200) / 2;
  
  // Place it near the bottom edge (Subtracting 60 to leave room for the 50px tall image)
  int planeY = screenH - 60; 
  
  // Draws the dynamic planeBitmap at 200x50 resolution
  tft.drawBitmap(planeX, planeY, planeBitmap, 200, 50, COLOR_LABEL);
  
}